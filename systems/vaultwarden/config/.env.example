# vaultwarden/.env — secrets and bootstrap toggles for the Vaultwarden container.
# Copy to .env and fill in real values; .env stays gitignored.

# --- Admin panel ---------------------------------------------------------------
# Token that unlocks the /admin diagnostics + user-management page.
# RECOMMENDED: store an Argon2 PHC hash rather than a plaintext token. Generate with:
#     docker run --rm -it vaultwarden/server /vaultwarden hash
# Paste the full "$argon2id$..." string below wrapped in SINGLE quotes so neither
# the shell nor Compose tries to expand the $ signs.
#   (A plain random token also works but is weaker at rest:  openssl rand -base64 48)
ADMIN_TOKEN='changeme-run-vaultwarden-hash'

# --- Registration --------------------------------------------------------------
# Steady state is false: single-user vault, no open signups.
# FIRST RUN ONLY: set to true, deploy, register your account at the DOMAIN, then
# set back to false and redeploy. See runbook.md "First-run bootstrap".
SIGNUPS_ALLOWED=false

# --- Optional: outbound email (password reset, admin invites, new-device alerts) --
# Leave commented to run mail-less; a single-user vault generally doesn't need SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_FROM=vaultwarden@lab.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=changeme
# SMTP_PASSWORD=changeme

# --- Optional: mobile push notifications --------------------------------------
# Bitwarden's push relay (so the iOS/Android app gets near-real-time vault syncs).
# Requires a free installation id/key from https://bitwarden.com/host . Off by
# default — with Tailscale-only access, push is a convenience, not a requirement.
# PUSH_ENABLED=true
# PUSH_INSTALLATION_ID=changeme
# PUSH_INSTALLATION_KEY=changeme
