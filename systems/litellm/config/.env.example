# LiteLLM master key — authenticates all requests to this gateway.
# Claude Code uses this as the value of ANTHROPIC_API_KEY when ANTHROPIC_BASE_URL is set.
# Generate: openssl rand -hex 16 | sed 's/^/sk-/'
LITELLM_MASTER_KEY=sk-replace-this

# Anthropic API key placeholder. LiteLLM model config requires a non-empty value,
# but it is not used for auth — Claude Code's OAuth token is forwarded to Anthropic
# instead via forward_client_headers_to_llm_api. See build-log.md for the auth flow.
ANTHROPIC_API_KEY=not-used-oauth-forwarded

# Ollama base URL — must be reachable from docker-host, not localhost.
# Requires OLLAMA_HOST=0.0.0.0 on dev-workstation. See systems/ollama/runbook.md.
OLLAMA_BASE_URL=http://<dev-workstation-ip>:11434
