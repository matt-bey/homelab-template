# /etc/nut/handlers/ntfy.env — ntfy push settings for UPS alerts.
# Sourced by upssched-cmd. Copy to ntfy.env (gitignored). The defaults below are
# functional as-is (the homelab ntfy topic needs no auth), so seeding the .example
# is enough to get alerts working — only edit if you change the topic or add auth.
NTFY_URL="https://ntfy.lab.yourdomain.com"
NTFY_TOPIC="ups"
# Leave empty for an unauthenticated topic; set a token for a protected one.
NTFY_TOKEN=""
