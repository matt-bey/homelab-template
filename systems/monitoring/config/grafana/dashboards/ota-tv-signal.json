          "refId": "A"
        }
      ],
      "title": "Last probe cycle",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Time since the probe last pushed. If this climbs past ~12 min, the probe has stalled (Pushgateway keeps serving the last value, so the graphs would otherwise look frozen rather than empty).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
