      "title": "Current signal quality (snq)",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Per-station current ss / snq / seq and lock state.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Locked" },
            "properties": [
              { "id": "mappings", "value": [
                { "type": "value", "options": { "0": { "text": "no lock", "color": "red", "index": 0 }, "1": { "text": "locked", "color": "green", "index": 1 } } }
              ] },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "displayName": "snq", "desc": false }]
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ota_tv_signal_strength{station=~\"$station\"} > 0",
          "format": "table",
          "instant": true,
          "refId": "ss"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ota_tv_signal_quality{station=~\"$station\"} > 0",
          "format": "table",
          "instant": true,
          "refId": "snq"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ota_tv_symbol_quality{station=~\"$station\"} > 0",
          "format": "table",
          "instant": true,
          "refId": "seq"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ota_tv_locked{station=~\"$station\"}",
          "format": "table",
          "instant": true,
          "refId": "lock"
        }
      ],
      "title": "Current readings by station",
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "station", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true,
              "__name__ 1": true, "__name__ 2": true, "__name__ 3": true, "__name__ 4": true,
              "instance 1": true, "instance 2": true, "instance 3": true, "instance 4": true,
              "job 1": true, "job 2": true, "job 3": true, "job 4": true,
              "network 2": true, "network 3": true, "network 4": true,
              "virtual 2": true, "virtual 3": true, "virtual 4": true,
              "rf 2": true, "rf 3": true, "rf 4": true
            },
            "renameByName": {
              "station": "Station",
              "network 1": "Net",
              "virtual 1": "Ch",
              "rf 1": "RF",
              "Value #ss": "ss",
              "Value #snq": "snq",
              "Value #seq": "seq",
              "Value #lock": "Locked"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "1 = last cycle found a free tuner and swept. 0 = all four tuners were busy and the sweep was skipped.",
