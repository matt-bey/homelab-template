# monitoring/.env — Grafana admin credentials.
# Copy to .env and fill in real values; .env stays gitignored.

# Default admin user. Grafana 11 forces a password rotation on first login
# regardless, so this is just the bootstrap user.
GF_SECURITY_ADMIN_USER=admin

# Bootstrap password. Change immediately on first login (or pre-set a strong one here).
GF_SECURITY_ADMIN_PASSWORD=changeme

# Disable anonymous access — Grafana ships with this off, but make it explicit.
GF_AUTH_ANONYMOUS_ENABLED=false

# Disable user signup. We provision admin and that's it.
GF_USERS_ALLOW_SIGN_UP=false
