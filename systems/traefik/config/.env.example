# Cloudflare API token for DNS-01 challenge
# Required permissions: Zone > DNS > Edit, Zone > Zone > Read
# Scope to zone: yourdomain.com only
CF_DNS_API_TOKEN=

# Traefik dashboard basic auth — comma-separated for multiple users.
# Generate each entry with: htpasswd -nb <user> <password>
# Install htpasswd on macOS: brew install httpd
# Example single user:  admin:$apr1$abc123$...
# Example multi-user:   admin:$apr1$abc123$...,other:$apr1$def456$...
#
# IMPORTANT — do NOT escape `$` as `$$` here. The `$$` escape rule applies only
# to values written literally inside compose.yaml; values arriving via .env
# substitution are passed through verbatim. Paste the htpasswd output exactly
# as the command emits it (single `$`). Single-quoting is optional but harmless.
# Verify with: DOCKER_CONTEXT=docker-host docker inspect traefik | grep basicauth
# (not `docker compose config`, which shows pre-substitution state).
TRAEFIK_DASHBOARD_USERS=
