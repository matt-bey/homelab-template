# Address of the HDHomeRun. Use the IP, not the 8-char device ID: the probe
# container runs on a different subnet than the tuner (VLAN 30), and device-ID
# discovery relies on UDP broadcast that does not cross subnets. The IP is a
# static DHCP reservation — see systems/ota-tv/deployment.md.
HDHR_ADDR=<ota-tuner-ip>

# Prometheus Pushgateway endpoint (host:port) on the shared docker network.
# Lives in the monitoring stack — see systems/monitoring/config/compose.yaml.
PUSHGATEWAY_URL=pushgateway:9091

# Sweep cadence in seconds (default 10 min) and per-channel lock settle time.
# Settle is 5s, not 2s: a cold first-tune or a weak channel can need >2s to
# achieve lock, and reading early logs a false ss/snq/seq=0 (see notes.md).
PROBE_INTERVAL_SECONDS=600
TUNE_SETTLE_SECONDS=5
