# n8n/.env — secrets for the n8n container.
# Copy to .env and fill in real values; .env stays gitignored.

# Master encryption key for credentials stored in n8n's SQLite DB.
# Generate once with: openssl rand -hex 32
# WARNING: do not rotate. Changing this key makes existing stored credentials unrecoverable.
N8N_ENCRYPTION_KEY=changeme-run-openssl-rand-hex-32

# Optional: basic auth in front of the n8n UI itself (defense in depth even though
# Traefik already terminates TLS). Leave unset to rely on host-level auth only.
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=changeme
