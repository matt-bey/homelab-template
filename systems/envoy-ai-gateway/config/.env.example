# Shape of the secrets this POC needs. Unlike the Compose stacks, these are NOT loaded
# from a .env file — they become in-cluster Kubernetes Secrets. This file documents what
# to create and the kubectl command for each. Nothing here is committed with real values.

# --- Phase 1: cert-manager Cloudflare DNS-01 -------------------------------------------
# Cloudflare API token, scoped to the yourdomain.com zone (Zone>DNS>Edit, Zone>Zone>Read).
# Reuse a fresh token rather than Traefik's (separate issuer, separate token — see ADR).
# Create in the cert-manager namespace (ClusterIssuer reads it from there):
#   kubectl create secret generic cloudflare-api-token \
#     --namespace cert-manager \
#     --from-literal=api-token='<CF_DNS_API_TOKEN>'
CF_DNS_API_TOKEN=

# --- Phase 3 Tier A: Grafana MCP service-account key -----------------------------------
# Read-only Grafana service-account token. The gateway injects this upstream so clients
# never hold it (MCPRoute backendRefs[].securityPolicy.apiKey.secretRef). Create in aigw:
#   kubectl create secret generic grafana-mcp-sa \
#     --namespace aigw \
#     --from-literal=api-key='<GRAFANA_SA_TOKEN>'
GRAFANA_SA_TOKEN=

# --- Phase 2: Entra ID (issuer/JWKS come from the tenant, not secret) ------------------
# The MCPRoute securityPolicy.oauth needs the tenant's issuer + audience. These are
# config, not secrets, but recorded here so the values live in one place during setup.
ENTRA_TENANT_ID=
ENTRA_ISSUER=          # e.g. https://login.microsoftonline.com/<tenant-id>/v2.0
ENTRA_AUDIENCE=        # the MCP-gateway app registration's Application ID URI
